# Local development: SQLite is used when DATABASE_URL is unset.
# Hosted deployment: set all three variables in the hosting dashboard.
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
ADMIN_PASSWORD=change-me-to-a-unique-password
# Use the Supabase Connect URI (Transaction mode, port 6543).
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# APP_ENV=production
